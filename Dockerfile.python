# Dockerfile.python
# Builds and runs ONLY the Python bot. This deliberately copies just
# the Python-related files, so it ignores main.go and everything else
# sitting in the same repo root.

FROM python:3.12-slim
WORKDIR /app

COPY requirement.txt ./
RUN pip install --no-cache-dir -r requirement.txt

COPY notif.py ./

CMD ["python", "notif.py"]
