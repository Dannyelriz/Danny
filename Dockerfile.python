# Dockerfile.python
# Builds and runs ONLY the Python bot. This deliberately copies just
# the Python-related files, so it ignores main.go and everything else
# sitting in the same repo root.

FROM python:3.12-slim
WORKDIR /app

# FIX 1: Corrected to requirements.txt
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY notif.py ./

# FIX 2: Added -u for real-time Render logging
CMD ["python", "-u", "notif.py"]